<h1>Flights#index</h1>
<p>Find me in app/views/flights/index.html.erb</p>

<%= form_with method: :get do |form| %>
  <div>
    <%= form.collection_select :departure_airport_id, Airport.order(:code), :id, :code %>
    <%= form.label :departure_airport_id, "Select departure airport" %>
  </div>

  <div>
    <%= form.collection_select :arrival_airport_id, Airport.order(:code), :id, :code %>
    <%= form.label :arrival_airport_id, "Select arrival airport" %>
  </div>

  <div>
    <%= form.select :passengers, %w[1 2 3 4] %>
    <%= form.label :passengers, "Select passenger number" %>
  </div>

  <div>
    <%= form.collection_select :flight_date, @flights.order(:start), :id, :flight_date_formatted %>
  </div>

  <div>
    <%= form.submit "Search flight" %>
  </div>
<% end %>