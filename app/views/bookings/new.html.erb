<h1>Bookings#new</h1>
<p>Find me in app/views/bookings/new.html.erb</p>

<p>
  Booking flight: <br>
  Date: <%= @flight.flight_date_formatted %><br>
  Departure: <%= @flight.departure_airport.code %><br>
  Arrival: <%= @flight.arrival_airport.code %><br>
  Flight id: <%= @flight.id %>
</p>

<%= form_with model: @booking do |booking_form| %>
  <%= booking_form.hidden_field :flight_id, value: @flight.id %>
  <%= booking_form.fields_for :passengers do |passenger_form| %>
    name: <%= passenger_form.text_field :name %>
    email: <%= passenger_form.text_field :email %>
    <br>
  <% end %>
  <%= booking_form.submit "Submit passenger info" %>
<% end %>